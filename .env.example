DATABASE_URL=postgres://inofarma:password@127.0.0.1:5432/inofarma_next
REDIS_URL=redis://127.0.0.1:6379

# Signs links (email verification) and session tokens: openssl rand -base64 32
APP_KEY=

# Payments / shipping / notifications
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PRODUCTION=false
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_ORDER_SHIPPED=
WHATSAPP_TEMPLATE_ORDER_READY=

# Storage: where uploads go (public = local disk, s3 = R2/S3, gcs = Google Cloud Storage)
APP_URL=http://localhost:3000
UPLOADS_DISK=public
# Rows Laravel wrote point at its own dev server; treat them as this disk's files
UPLOADS_LEGACY_URLS=http://localhost:8000/storage
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=
GOOGLE_CLOUD_STORAGE_API_URI=
GOOGLE_CLOUD_KEY_FILE=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

# Mail: "log" writes emails to the server log (like Laravel's MAIL_MAILER=log), "smtp" sends them
MAIL_MAILER=log
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Inofarma

# The only variable that is safe to expose to the browser
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
